{
  "level_display": "tconstruct:default",
  "modules": [
    {
      "type": "tconstruct:conditional_stat",
      "formula": [
        "$sky",
        "$block",
        "max",
        15.0,
        "!-",
        0.01,
        "*",
        "$level",
        "*",
        "$value",
        "+"
      ],
      "percent": false,
      "stat": "tconstruct:draw_speed",
      "variables": {
        "block": {
          "type": "tconstruct:entity",
          "entity_type": "tconstruct:light",
          "fallback": 15.0,
          "light_layer": "block"
        },
        "sky": {
          "type": "tconstruct:entity",
          "entity_type": "tconstruct:light",
          "fallback": 15.0,
          "light_layer": "sky"
        }
      }
    },
    {
      "type": "tconstruct:protection",
      "damage_source": "mantle:can_protect",
      "formula": [
        "$sky",
        "$block",
        "max",
        15.0,
        "!-",
        "$level",
        "*",
        12.0,
        "/",
        "$protection",
        "+"
      ],
      "variables": {
        "block": {
          "type": "tconstruct:entity",
          "entity_type": "tconstruct:light",
          "fallback": 15.0,
          "light_layer": "block",
          "which": "target"
        },
        "sky": {
          "type": "tconstruct:entity",
          "entity_type": "tconstruct:light",
          "fallback": 15.0,
          "light_layer": "sky",
          "which": "target"
        }
      }
    }
  ],
  "show_in_tooltips": "always"
}